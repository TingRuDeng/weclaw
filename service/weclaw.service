[Unit]
Description=WeClaw - WeChat AI Agent Bridge
After=network.target

[Service]
Type=simple
Environment=WECLAW_SERVICE_MANAGER=systemd
ExecStart=/usr/local/bin/weclaw start --foreground
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
KillMode=process
TimeoutStopSec=15s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
